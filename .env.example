# Public hostname without protocol, for example: assistant.example.org
# Leave empty for MVP: deploy.sh will use <public-ip>.sslip.io automatically.
PUBLIC_HOST=

# Public application URL and OAuth callback. deploy.sh fills these automatically.
BASE_URL=
REDIRECT_URI=

# Google OAuth web client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Voice recognition. Required for the microphone/web voice mode.
ASSEMBLYAI_API_KEY=

# Session signing key. Leave empty and deploy.sh will generate a secure value.
WEB_SESSION_SECRET=

# Web Push. The VAPID private key is generated automatically next to DB_PATH.
# Set these only if you want to use an existing persistent key/contact URI.
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
WEB_PUSH_WORKER_INTERVAL_SECONDS=5

# Automatic local state backup. If BACKUP_DIR is empty, snapshots are stored
# outside the repository in ~/.local/share/personal-secretary/backups.
BACKUP_DIR=
BACKUP_RETENTION_DAYS=14

# Optional navigation. Calendar keeps working if the key is empty.
# openrouteservice Standard key; requests use https://api.heigit.org.
NAVIGATION_PROVIDER=ors
ORS_API_KEY=

# Legacy/fallback navigation providers. Not used by default.
GOOGLE_MAPS_API_KEY=
DGIS_API_KEY=
YANDEX_GEOCODER_API_KEY=
YANDEX_ROUTING_API_KEY=

# AI assistant. For personal development add the GigaChat Authorization Key here.
# If the key is empty, all deterministic features continue to work and AI stays inactive.
AI_ENABLED=1
AI_PROVIDER=gigachat
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=700
# Optional. Leave empty: the app prepares its own isolated CA bundle for GigaChat.
GIGACHAT_CA_BUNDLE=

# Optional integrations
OPENAI_API_KEY=
TG_TOKEN=

# Runtime defaults
WEB_HOST=127.0.0.1
WEB_PORT=8080
DB_PATH=data/bot.db
# Disable only in isolated tests or on a web worker without notification duties.
WEB_PUSH_WORKER_ENABLED=1
