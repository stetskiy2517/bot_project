# Public hostname without protocol, for example: assistant.example.org
# Leave empty for MVP: deploy.sh will use <public-ip>.sslip.io automatically.
PUBLIC_HOST=

# Public application URL and OAuth callback. deploy.sh fills these automatically.
BASE_URL=
REDIRECT_URI=

# Google OAuth web client
# For Gmail read-only integration also add this authorized redirect URI in Google Cloud:
# <BASE_URL>/api/email/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Yandex ID login. Register this redirect URI in Yandex OAuth:
# <BASE_URL>/auth/yandex/callback
# If YANDEX_ID_REDIRECT_URI is empty, the app derives it from BASE_URL.
YANDEX_ID_CLIENT_ID=
YANDEX_ID_CLIENT_SECRET=
YANDEX_ID_REDIRECT_URI=

# Owner/admin access. Comma-separated account emails allowed to open /admin.
# Keep this in the server .env or secret storage; do not hard-code real addresses in Git.
ADMIN_EMAILS=

# Voice recognition. Providers are tried in this order.
# AssemblyAI keeps support for the current browser formats.
# Yandex SpeechKit v1 is a short-audio OggOpus fallback (up to 30 sec / 1 MB).
SPEECH_PROVIDER_ORDER=assemblyai,yandex
ASSEMBLYAI_API_KEY=
YANDEX_SPEECHKIT_API_KEY=
# Alternative to API key for SpeechKit. For IAM auth also set folder id.
YANDEX_SPEECHKIT_IAM_TOKEN=
YANDEX_SPEECHKIT_FOLDER_ID=

# Session signing key. Leave empty and deploy.sh will generate a secure value.
WEB_SESSION_SECRET=

# Optional separate encryption secret for IMAP app passwords and Gmail tokens.
# If empty, the application derives the encryption key from WEB_SESSION_SECRET.
EMAIL_CREDENTIALS_KEY=

# Automatic email analysis worker.
# Per-user analysis is still opt-in in Settings -> Email.
# The worker scans cheaply on an interval, creates a no-AI baseline on first enable,
# fingerprints processed messages, and sends only new candidate messages/files to AI.
EMAIL_AUTO_WORKER_ENABLED=1
EMAIL_AUTO_INTERVAL_SECONDS=900

# Web Push. The VAPID private key is generated automatically next to DB_PATH.
# Set these only if you want to use an existing persistent key/contact URI.
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
WEB_PUSH_WORKER_INTERVAL_SECONDS=5

# Automatic local state backup. If BACKUP_DIR is empty, snapshots are stored
# outside the repository in ~/.local/share/personal-secretary/backups.
BACKUP_DIR=
BACKUP_RETENTION_DAYS=14

# Optional navigation. Calendar keeps working if the key is empty.
# openrouteservice Standard key; requests use https://api.heigit.org.
NAVIGATION_PROVIDER=ors
ORS_API_KEY=

# Legacy/fallback navigation providers. Not used by default.
GOOGLE_MAPS_API_KEY=
DGIS_API_KEY=
YANDEX_GEOCODER_API_KEY=
YANDEX_ROUTING_API_KEY=

# AI assistant. The deterministic calendar/reminder core never depends on AI.
# beta: AI is available to authenticated beta users unless explicitly disabled by an admin.
# entitled: AI is available only to users with an explicit paid/managed entitlement.
# off: AI is unavailable to all users.
AI_ACCESS_MODE=beta
AI_ENABLED=1
AI_PROVIDER=gigachat
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
# File/image analysis defaults to Pro because it supports multimodal input.
GIGACHAT_FILE_MODEL=GigaChat-2-Pro
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=700
# Optional. Leave empty: the app prepares its own isolated CA bundle for GigaChat.
GIGACHAT_CA_BUNDLE=

# Learned AI memory. No additional secret is required.
# Memory extraction never executes calendar/reminder actions by itself.
AI_MEMORY_ENABLED=1
AI_MEMORY_WORKER_ENABLED=1
AI_MEMORY_WORKER_INTERVAL_SECONDS=15
AI_MEMORY_CALENDAR_SYNC_INTERVAL_SECONDS=600
AI_MEMORY_CALENDAR_LOOKBACK_DAYS=7
AI_MEMORY_CALENDAR_LOOKAHEAD_DAYS=30

# Optional integrations
OPENAI_API_KEY=
TG_TOKEN=

# Runtime defaults
WEB_HOST=127.0.0.1
WEB_PORT=8080
DB_PATH=data/bot.db
# Disable only in isolated tests or on a web worker without notification duties.
WEB_PUSH_WORKER_ENABLED=1
