# Public hostname without protocol, for example: assistant.example.org
PUBLIC_HOST=

# Public application URL and OAuth callback. deploy.sh fills these automatically
# when they are omitted and PUBLIC_HOST is set.
BASE_URL=
REDIRECT_URI=

# Google OAuth web client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Voice recognition. Required for the microphone/web voice mode.
# The web app uses the same AssemblyAI recognition flow as the old bot version.
ASSEMBLYAI_API_KEY=

# Generate a long random value before production deployment.
WEB_SESSION_SECRET=

# Optional integrations
OPENAI_API_KEY=
TG_TOKEN=

# Runtime defaults
WEB_HOST=0.0.0.0
WEB_PORT=8080
DB_PATH=/app/data/bot.db
