# Public hostname without protocol, for example: assistant.example.org
# Leave empty for MVP: deploy.sh will use <public-ip>.sslip.io automatically.
PUBLIC_HOST=

# Public application URL and OAuth callback. deploy.sh fills these automatically.
BASE_URL=
REDIRECT_URI=

# Google OAuth web client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Voice recognition. Required for the microphone/web voice mode.
ASSEMBLYAI_API_KEY=

# Session signing key. Leave empty and deploy.sh will generate a secure value.
WEB_SESSION_SECRET=

# Web Push. The VAPID private key is generated automatically next to DB_PATH.
# Set these only if you want to use an existing persistent key/contact URI.
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
WEB_PUSH_WORKER_INTERVAL_SECONDS=5

# Automatic local state backup. If BACKUP_DIR is empty, snapshots are stored
# outside the repository in ~/.local/share/personal-secretary/backups.
BACKUP_DIR=
BACKUP_RETENTION_DAYS=14

# Optional integrations
OPENAI_API_KEY=
TG_TOKEN=

# Runtime defaults
WEB_HOST=127.0.0.1
WEB_PORT=8080
DB_PATH=data/bot.db
