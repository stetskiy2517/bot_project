# Public hostname without protocol, for example: assistant.example.org
# Leave empty for MVP: deploy.sh will use <public-ip>.sslip.io automatically.
PUBLIC_HOST=

# Public application URL and OAuth callback. deploy.sh fills these automatically.
BASE_URL=
REDIRECT_URI=

# Google OAuth web client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Voice recognition. Required for the microphone/web voice mode.
ASSEMBLYAI_API_KEY=

# Session signing key. Leave empty and deploy.sh will generate a secure value.
WEB_SESSION_SECRET=

# Optional integrations
OPENAI_API_KEY=
TG_TOKEN=

# Runtime defaults
WEB_HOST=127.0.0.1
WEB_PORT=8080
DB_PATH=data/bot.db
